# NOTE: .dockerignore patterns are NOT .gitignore patterns. A bare pattern like
# `.venv/` matches only the context root — it does NOT apply at every depth the
# way git does. Nested paths need an explicit `**/` prefix. (This bit us with
# app/.venv, ~188 MB of site-packages that was being copied into the image.)

# Python
**/__pycache__/
**/*.py[cod]
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
**/.venv/
**/venv/
**/env/

# Testing / linting caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Logs
**/*.log
logs/

# Environment & secrets — NEVER bake into image
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/
**/*.swp

# Frontend (built and shipped separately)
frontend/

# Docker files themselves
Dockerfile
docker-compose.yml
.dockerignore

# VCS / CI / deploy-CLI state
.git/
.gitignore
.github/
.fastapicloud/

# Audio test fixtures
**/*.wav
**/*.mp3
**/*.m4a
