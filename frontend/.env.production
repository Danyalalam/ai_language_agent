# Backend (FastAPI on FastAPI Cloud) base URL, used at build time by Vite.
# The REST client and the voice WebSocket both derive from this:
#   REST -> https://speak-german.fastapicloud.dev/api/...
#   WS   -> wss://speak-german.fastapicloud.dev/api/voice/live
# If your backend URL changes, update this value (or override VITE_API_BASE_URL
# in the Vercel project's Environment Variables) and redeploy the frontend.
VITE_API_BASE_URL=https://speak-german.fastapicloud.dev/api
